rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function hasTokenRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isStoreOwner(storeId) {
      return hasTokenRole('owner') && request.auth.token.storeId == storeId;
    }

    function isStoreStaff(storeId) {
      return hasTokenRole('staff') && request.auth.token.storeId == storeId;
    }

    function isCustomer() {
      return hasTokenRole('customer');
    }

    // Connection testing doc
    match /test/connection {
      allow read: if true;
    }

    // STORES: public get and list. Client update allowed only if owner of this store
    // and affectedKeys do NOT include planSlug, extraSeats, isActive, ownerUserId, id, createdAt.
    // No client create or delete.
    match /stores/{storeId} {
      allow get: if isValidId(storeId);
      allow list: if true;
      allow create: if false;
      allow delete: if false;
      allow update: if isValidId(storeId)
        && isStoreOwner(storeId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'planSlug', 'extraSeats', 'isActive', 'ownerUserId', 'id', 'createdAt'
        ]);

      // Meta docs: server/Admin SDK only
      match /meta/{docId} {
        allow read, write: if false;
      }

      // Categories: public read. Client write only if store owner.
      match /categories/{categoryId} {
        allow read: if isValidId(categoryId);
        allow create, update, delete: if isValidId(categoryId) && isStoreOwner(storeId);
      }

      // Products: public read. Client write only if store owner (soldCount is protected from client edits).
      match /products/{productId} {
        allow read: if isValidId(productId);
        allow create: if isValidId(productId) && isStoreOwner(storeId) && (!('soldCount' in request.resource.data) || request.resource.data.soldCount == 0);
        allow update: if isValidId(productId) && isStoreOwner(storeId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['soldCount']);
        allow delete: if isValidId(productId) && isStoreOwner(storeId);
      }

      // Orders: no client write. Read allowed if:
      // (a) owner of that store,
      // (b) staff of that store and resource.data.placedByUserId == request.auth.token.userId, or
      // (c) customer with resource.data.customerId == request.auth.token.customerId
      match /orders/{orderId} {
        allow write: if false;
        allow get, list: if isValidId(orderId) && (
          isStoreOwner(storeId)
          || (isStoreStaff(storeId) && resource.data.placedByUserId == request.auth.token.userId)
          || (isCustomer() && resource.data.customerId == request.auth.token.customerId)
        );

        match /events/{eventId} {
          allow write: if false;
          allow get, list: if isValidId(eventId) && (
            isStoreOwner(storeId)
            || isStoreStaff(storeId)
            || isCustomer()
          );
        }
      }
    }

    // Server-only collections: users, customers, memberships, aiMessages, pendingActions, aiUsage
    // NO client read or write (server/Admin SDK only). passwordHash and salt never reach the browser.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /customers/{customerId} {
      allow read, write: if false;

      match /addresses/{addressId} {
        allow read, write: if false;
      }
    }

    match /memberships/{membershipId} {
      allow read, write: if false;
    }

    match /aiMessages/{messageId} {
      allow read, write: if false;
    }

    match /pendingActions/{actionId} {
      allow read, write: if false;
    }

    match /aiUsage/{usageId} {
      allow read, write: if false;
    }
  }
}
